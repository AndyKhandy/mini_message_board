<html>
    <head>
        <link rel="stylesheet" href="/styles.css">
    </head>
    <body>
        <h1><%= title %></h1>
        <% messages.forEach((message) => { %>
            <h2>User</h2>
            <%- include('messageInfo', {message}) %>
            <a href=<%= message.id%>>Open</a>
        <% }) %>
        <div id="createNew">
            <a href="/new">Create new message!</a>
        </div>
    </body>
</html>